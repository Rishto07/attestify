# Verdict configuration — copy to `.env` and fill in YOUR values.
# The `.env` file is git-ignored and never committed. Your key stays on your machine.

# --- LLM for the Prosecutor (adversarial judge) ---
# Base URL of any OpenAI-compatible endpoint (OpenAI, Groq, Together,
# OpenRouter, Azure, LiteLLM proxy, etc.). For OpenAI it is:
#   https://api.openai.com/v1
VERDICT_LLM_URL=

# Your API key. Never commit this. The real environment wins over .env,
# so you can also `export VERDICT_LLM_KEY=...` instead of editing a file.
VERDICT_LLM_KEY=

# Model name as your provider expects it, e.g. gpt-4o-mini, llama-3.1-8b, ...
VERDICT_LLM_MODEL=

# --- Optional ---
# Force a sandbox: docker (isolated) | subprocess (NOT isolated) | auto
# VERDICT_SANDBOX=auto

# Where receipts are stored (default: ./verdict-data)
# VERDICT_DATA_DIR=./verdict-data